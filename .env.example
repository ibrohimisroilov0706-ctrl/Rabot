# .env.example — nusxa oling: cp .env.example .env

# --- Majburiy
POSTGRES_PASSWORD=ozgartiring-kuchli-parol
# Kamida 32 belgi. Yaratish: openssl rand -hex 32
JWT_SECRET=ozgartiring-kamida-32-belgili-tasodifiy-satr-0000000000
# @BotFather bergan token
TELEGRAM_BOT_TOKEN=123456789:AAAA-bot-token

# Lokal ishlab chiqishda (npm run dev:server) kerak; docker compose o'zi to'ldiradi
DATABASE_URL=postgres://qirolliklar:ozgartiring-kuchli-parol@localhost:5432/qirolliklar

# --- Ixtiyoriy
NODE_ENV=production
# HTTPS domen (Caddy sertifikatni o'zi oladi). Bo'sh bo'lsa deploy skripti IP-sslip.io ishlatadi
DOMAIN=
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=
# Prototipda vaqtni tezlashtirish (1 = real vaqt, 10 = 10 barobar tez)
GAME_SPEED=1
# Yangi o'yinchi himoya qalqoni (soat)
SHIELD_HOURS=72
# Faqat lokal ishlab chiqish uchun! Productionda server ishga tushmaydi.
DEV_AUTH=false
# Telegram Mini App domeningiz (vergul bilan bir nechta)
CORS_ORIGIN=*
# Cloudflare / nginx ortida bo'lsa true (X-Forwarded-For dan IP oladi)
TRUST_PROXY=true
# Masshtablash: API va World Engine ni alohida jarayonlarga ajratish
API_ENABLED=true
ENGINE_ENABLED=true
DB_POOL_SIZE=20
